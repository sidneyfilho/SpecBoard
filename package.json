{
  "name": "specboard",
  "version": "0.1.0",
  "description": "Este pacote descreve o produto e orienta o Antigravity a construir a primeira versão do SpecBoard.",
  "directories": {
    "example": "examples"
  },
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "vue-tsc --noEmit && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "vue-tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "dompurify": "^3.4.17",
    "marked": "^18.1.2",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vuetify": "^4.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "private": true
}
